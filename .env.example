# Токен для Telegram-бота, полученный у @BotFather
TELEGRAM_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# Токен для платформы Max (если используется)
MAX_TOKEN=your_max_token_here

# Настройки среды
ASPNETCORE_ENVIRONMENT=Production

# Уникальный идентификатор экземпляра бота для изоляции сессий
BOT_INSTANCE_ID=botengine-example

# Строка подключения к Redis (если используется RedisUserSessionStore)
# REDIS_CONNECTION_STRING=redis:6379
