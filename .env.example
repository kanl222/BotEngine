# Токен для Telegram-бота, полученный у @BotFather
TELEGRAM_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# Токен для платформы Max (если используется)
MAX_TOKEN=your_max_token_here

# Настройки среды
ASPNETCORE_ENVIRONMENT=Production

# Строка подключения к Redis (задел на будущее для хранения сессий)
# REDIS_CONNECTION_STRING=redis:6379
