    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>BotEngine.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>YourOrg</Authors>
    <Description>Platform-agnostic bot engine core: models, interfaces, dispatcher, session store.</Description>
